__id__ = "topic_notifications"
__name__ = "Topic Notifications"
__description__ = "In forum groups, reading or sending in one topic only clears that topic. Other topics keep their unread counts and notifications. Normal chats are untouched."
__author__ = "Justice"
__version__ = "1.0.5"

# How stock Telegram (and Nagram XF) handles reads in a forum group:
#   * the server reports "read up to message N" for the whole group
#     (updateReadChannelInbox), and NotificationsController.processReadMessages
#     drops every pending notification of that group with id <= N, whatever topic
#     it is in;
#   * MessagesController.markDialogAsRead then calls processDialogsUpdateRead with
#     a count of 0, which wipes the whole group's notification set.
# Sending a message in a topic moves that group wide read mark to the new message,
# so every other topic's notifications vanish too.
#
# This plugin, for forum groups only:
#   1. stops those two group wide wipes (the calls are passed through with the
#      forum entries taken out);
#   2. remembers how far each TOPIC has been read (local reads, reads from other
#      devices, and messages you send into a topic);
#   3. removes only the notifications whose own topic has been read, then refreshes
#      the notification shade silently (no new sound or vibration).
# When the app reloads its pending notifications from the database (app start,
# chat list refresh, often right after you send), stock rebuilds the list in a way
# that loses other topics: it skips the whole group while any topic of it is open,
# and the database already counts every topic as read after a group wide read mark.
# The plugin keeps a copy of each forum group's pending notifications from just
# before the reload, puts back the ones whose topic you have not read, then prunes
# the ones whose topic you have read.
# Groups that show topics as tabs (like a busy bot group) have one more trap:
# after a group wide read mark the app raises every topic's own read mark in its
# database too. So the plugin trusts only reads that name a topic (opening it here,
# a topic read reported by the server from another device, or sending into it).
# Stock also never notifies about a group while any of its topics is open on
# screen; with this plugin, new messages in OTHER topics still notify while you
# sit in one topic. Messages in the topic you are looking at stay silent.
# The root of the lost badges: in a group that shows topics as tabs, every group
# wide read mark (and sending a message moves it to your own message) makes the
# app run MessagesStorage.updateTopicsWithReadFromAllInternal, which marks EVERY
# topic read in its database, zeroes their badges, and then clears the whole
# group's notifications through resetForumBadgeIfNeed. Since 1.0.4 the plugin
# skips that step for normal forum groups, unless you just read the group from
# its All tab. Each topic then keeps its unread badge and notifications until you
# open it or read it elsewhere.
# The server does the same: after a send it reports every topic of a tabs group
# as read, so the badges came back as zero whenever the app reloaded its topic list
# (a restart, or reopening the group later). Since 1.0.5 the plugin keeps its own
# read mark per topic in tn_reads.json and puts it back over whatever the server
# or the database reports, with the right unread count. A mark only moves when you
# open that topic, read it on another device, send into it, or read the All tab.
# Every decision is written to logcat (tag TopicNotif) and to tn_log.txt in the
# app's files folder (about 1 MB, one old copy kept).
# Muting or clearing a whole group (removeNotificationsForDialog) still clears
# everything, exactly like stock. Private chats, normal groups and channels are
# never touched.

import os
import threading
import time

from java import jclass, jarray
from base_plugin import BasePlugin, MethodHook, HookResult
from hook_utils import find_class, get_private_field, get_static_private_field
from android_utils import R, run_on_ui_thread

MessagesController = jclass("org.telegram.messenger.MessagesController")
NotificationsController = jclass("org.telegram.messenger.NotificationsController")
NotificationCenter = jclass("org.telegram.messenger.NotificationCenter")
LongSparseIntArray = jclass("org.telegram.messenger.support.LongSparseIntArray")
JBoolean = jclass("java.lang.Boolean")
JObject = jclass("java.lang.Object")

INT_MAX = 2147483647
ALL_TAB_WINDOW_S = 15
PRUNE_DELAY_MS = 350
LOG_TAG = "TopicNotif"
LOG_MAX = 1000000
_log_lock = threading.Lock()
_log_path = [None]


def _tlog(msg):
    try:
        jclass("android.util.Log").i(LOG_TAG, msg)
    except Exception:
        pass
    try:
        with _log_lock:
            if _log_path[0] is None:
                ctx = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
                _log_path[0] = os.path.join(str(ctx.getFilesDir().getAbsolutePath()), "tn_log.txt")
            path = _log_path[0]
            if os.path.exists(path) and os.path.getsize(path) > LOG_MAX:
                os.replace(path, path + ".1")
            with open(path, "a") as f:
                f.write(time.strftime("%m-%d %H:%M:%S ") + msg + "\n")
    except Exception:
        pass


def _stack():
    out = []
    try:
        for e in jclass("java.lang.Exception")().getStackTrace():
            c = str(e.getClassName())
            if c.startswith("org.telegram") or c.startswith("tw.") or c.startswith("xyz.") or c.startswith("top."):
                out.append("%s.%s" % (c.split(".")[-1], e.getMethodName()))
    except Exception:
        pass
    return "<".join(out[:8])


def _tabs_forum(account, dialog_id):
    """A normal forum group (tabs or list), not a direct messages or bot forum."""
    try:
        dialog_id = int(dialog_id)
        if dialog_id >= 0:
            return False
        chat = MessagesController.getInstance(account).getChat(-dialog_id)
        if chat is None:
            return False
        return bool(chat.forum) and not bool(chat.monoforum)
    except Exception:
        return False


def _account_of(controller):
    try:
        return int(get_private_field(controller, "currentAccount"))
    except Exception:
        return 0


def _is_forum(account, dialog_id):
    """True only for real forum supergroups (not mono forums, not bot forums)."""
    try:
        dialog_id = int(dialog_id)
        if dialog_id >= 0:
            return False
        mc = MessagesController.getInstance(account)
        return bool(mc.isForum(dialog_id)) and not bool(mc.isMonoForum(dialog_id))
    except Exception:
        return False


class TopicNotificationsPlugin(BasePlugin):

    def on_plugin_load(self):
        self.read_max = {}          # (account, dialog_id, topic_id) -> highest read message id
        self.pending = set()        # (account, dialog_id) waiting for a prune pass
        self.clearing = set()       # (account, dialog_id) inside a stock "clear all" call
        self.snapshots = {}         # account -> forum notifications from just before a reload
        self.lock = threading.Lock()
        self.open_gen = 0           # bumps on every setOpenedDialogId call
        self.reentry = threading.local()
        self.all_tab_read = {}      # (account, dialog_id) -> time of a read from the All tab
        self.floors = {}            # (account, dialog_id) -> read mark from an All tab read
        self.reads_path = None
        self._load_reads()

        nc_cls = find_class("org.telegram.messenger.NotificationsController")
        mc_cls = find_class("org.telegram.messenger.MessagesController")
        lsia_cls = find_class("org.telegram.messenger.support.LongSparseIntArray")
        L = jclass("java.lang.Long").TYPE
        I = jclass("java.lang.Integer").TYPE
        Z = jclass("java.lang.Boolean").TYPE

        self.queue = get_static_private_field(nc_cls, "notificationsQueue")
        self.show_method = nc_cls.getDeclaredMethod("showOrUpdateNotification", Z)
        self.show_method.setAccessible(True)

        plugin = self

        class ReadMessagesHook(MethodHook):
            def before_hooked_method(self, param):
                plugin._before_process_read_messages(param)

        class DialogsUpdateReadHook(MethodHook):
            def before_hooked_method(self, param):
                plugin._before_dialogs_update_read(param)

        class RemoveForDialogHook(MethodHook):
            def before_hooked_method(self, param):
                key = (_account_of(param.thisObject), int(param.args[0]))
                if _is_forum(key[0], key[1]):
                    _tlog("removeNotificationsForDialog %d from %s" % (key[1], _stack()))
                with plugin.lock:
                    plugin.clearing.add(key)

            def after_hooked_method(self, param):
                key = (_account_of(param.thisObject), int(param.args[0]))
                with plugin.lock:
                    plugin.clearing.discard(key)

        class MarkDialogAsReadHook(MethodHook):
            def before_hooked_method(self, param):
                plugin._before_mark_dialog_as_read(param)

        self.hook_method(nc_cls.getDeclaredMethod("processReadMessages", lsia_cls, L, I, I, Z), ReadMessagesHook())
        self.hook_method(nc_cls.getDeclaredMethod("processDialogsUpdateRead", lsia_cls), DialogsUpdateReadHook())
        self.hook_method(nc_cls.getDeclaredMethod("removeNotificationsForDialog", L), RemoveForDialogHook())
        self.hook_method(mc_cls.getDeclaredMethod("markDialogAsRead", L, I, I, I, Z, L, I, Z, I), MarkDialogAsReadHook())

        class OpenedHook(MethodHook):
            def before_hooked_method(self, param):
                with plugin.lock:
                    plugin.open_gen += 1
                try:
                    did = int(param.args[0])
                    if did < 0:
                        acc = _account_of(param.thisObject)
                        run_on_ui_thread(lambda: plugin._reconcile(acc, did))
                except Exception as e:
                    _tlog("opened hook: %s" % e)

        class NewMessagesHook(MethodHook):
            def before_hooked_method(self, param):
                plugin._before_new_messages(param)

        self.hook_method(nc_cls.getDeclaredMethod("setOpenedDialogId", L, L), OpenedHook())
        for m in nc_cls.getDeclaredMethods():
            if m.getName() == "processNewMessages":
                self.hook_method(m, NewMessagesHook())

        class ReloadHook(MethodHook):
            def before_hooked_method(self, param):
                plugin._before_reload(param)

            def after_hooked_method(self, param):
                plugin._after_reload(param)

        for m in nc_cls.getDeclaredMethods():
            if m.getName() == "processLoadedUnreadMessages":
                self.hook_method(m, ReloadHook())

        # Topic reads reported by the server (other devices, or the server echo of ours).
        ms_cls = find_class("org.telegram.messenger.MessagesStorage")

        class ReadAllTopicsHook(MethodHook):
            def before_hooked_method(self, param):
                plugin._before_read_all_topics(param)

        self.hook_method(ms_cls.getDeclaredMethod("updateTopicsWithReadFromAllInternal", L, L, L), ReadAllTopicsHook())

        class ProcessTopicsHook(MethodHook):
            def before_hooked_method(self, param):
                plugin._before_process_topics(param)

            def after_hooked_method(self, param):
                try:
                    acc = _account_of(param.thisObject)
                    did = -int(param.args[0])
                    run_on_ui_thread(lambda: plugin._reconcile(acc, did))
                except Exception as e:
                    _tlog("process topics after: %s" % e)

        tc_cls = find_class("org.telegram.messenger.TopicsController")
        for m in tc_cls.getDeclaredMethods():
            if m.getName() == "processTopics":
                self.hook_method(m, ProcessTopicsHook())


        class CancelLogHook(MethodHook):
            def before_hooked_method(self, param):
                try:
                    _tlog("CANCEL notification %s from %s" % ([str(x)[:20] for x in param.args], _stack()))
                except Exception:
                    pass

        try:
            nmc = find_class("androidx.core.app.NotificationManagerCompat")
            for m in nmc.getDeclaredMethods():
                if m.getName() in ("cancel", "cancelAll"):
                    self.hook_method(m, CancelLogHook())
        except Exception as e:
            _tlog("cancel log hook: %s" % e)

        self.add_hook("updateReadChannelDiscussionInbox", True)
        self.add_hook("updateReadChannelInbox", True)
        # Sending into a topic counts as reading that topic, like stock.
        self.add_on_send_message_hook()
        self.log("Topic Notifications loaded")
        _tlog("loaded %s" % __version__)

    # ---------- topic read bookkeeping ----------

    def _load_reads(self):
        try:
            import json
            ctx = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
            self.reads_path = os.path.join(str(ctx.getFilesDir().getAbsolutePath()), "tn_reads.json")
            if os.path.exists(self.reads_path):
                with open(self.reads_path) as f:
                    data = json.load(f)
                for k, v in data.get("topics", {}).items():
                    a, d, t = k.split("|")
                    self.read_max[(int(a), int(d), int(t))] = int(v)
                for k, v in data.get("floors", {}).items():
                    a, d = k.split("|")
                    self.floors[(int(a), int(d))] = int(v)
            _tlog("read marks loaded: %d topics" % len(self.read_max))
        except Exception as e:
            _tlog("load reads: %s" % e)

    def _save_reads(self):
        try:
            import json
            with self.lock:
                data = {"topics": dict(("%d|%d|%d" % k, v) for k, v in self.read_max.items()),
                        "floors": dict(("%d|%d" % k, v) for k, v in self.floors.items())}
            if self.reads_path:
                tmp = self.reads_path + ".tmp"
                with open(tmp, "w") as f:
                    json.dump(data, f)
                os.replace(tmp, self.reads_path)
        except Exception as e:
            _tlog("save reads: %s" % e)

    def _mark_topic_read(self, account, dialog_id, topic_id, max_id):
        if topic_id is None or max_id is None or int(max_id) <= 0:
            return
        key = (account, int(dialog_id), int(topic_id))
        changed = False
        with self.lock:
            if self.read_max.get(key, 0) < int(max_id):
                self.read_max[key] = int(max_id)
                changed = True
            if len(self.read_max) > 5000:   # keep memory small
                self.read_max.clear()
                self.read_max[key] = int(max_id)
        if changed:
            self._save_reads()

    def _mark(self, account, dialog_id, topic_id):
        """This plugin's read mark for a topic, or None if it has never seen the topic."""
        with self.lock:
            m = self.read_max.get((account, dialog_id, topic_id))
            f = self.floors.get((account, dialog_id))
        if m is None and f is None:
            return None
        return max(m or 0, f or 0)

    def _topic_read_max(self, account, dialog_id, topic_id):
        # Only reads that name this topic count: a read inside the topic here, a
        # topic read reported by the server (other devices), or a send into it.
        # The app's own topic objects are not used: after a group wide read mark
        # (sending anywhere in the group) the app raises every topic's read mark
        # locally, which would wrongly clear topics you have not opened.
        m = self._mark(account, dialog_id, topic_id)
        return m or 0

    # ---------- hooks ----------

    def _before_mark_dialog_as_read(self, param):
        try:
            account = _account_of(param.thisObject)
            dialog_id = int(param.args[0])
            if not _is_forum(account, dialog_id):
                return
            max_id = int(param.args[1])
            thread_id = int(param.args[5])
            _tlog("markDialogAsRead %d max=%d topic=%d" % (dialog_id, max_id, thread_id))
            if thread_id == 0:
                with self.lock:
                    self.all_tab_read[(account, dialog_id)] = time.time()
            if thread_id != 0:
                # Reading inside one topic: stock never clears notifications here
                # and relies on the group wide server echo instead. We clear this topic.
                self._mark_topic_read(account, dialog_id, thread_id, max_id)
            elif 0 < max_id < INT_MAX:
                # A read with no topic (bot button, flat view): count it only for the
                # topic of the message that was read.
                self._schedule(account, dialog_id, read_message=max_id)
                return
            self._schedule(account, dialog_id)
        except Exception as e:
            self.log("markDialogAsRead hook: %s" % e)

    def _before_process_read_messages(self, param):
        try:
            account = _account_of(param.thisObject)
            inbox = param.args[0]
            if inbox is not None:
                kept = LongSparseIntArray()
                changed = False
                for i in range(inbox.size()):
                    did = int(inbox.keyAt(i))
                    if _is_forum(account, did):
                        changed = True
                        self._schedule(account, did)
                    else:
                        kept.put(did, inbox.valueAt(i))
                if changed:
                    param.args[0] = kept if kept.size() > 0 else None
            dialog_id = int(param.args[1])
            max_id = int(param.args[3])
            _tlog("processReadMessages dialog=%d max=%d inbox=%s" % (dialog_id, max_id, None if param.args[0] is None else int(param.args[0].size())))
            if dialog_id != 0 and max_id != INT_MAX and _is_forum(account, dialog_id):
                # Group wide "read up to N": neutralise it, the prune pass does it per topic.
                param.args[1] = jclass("java.lang.Long")(0)
                self._schedule(account, dialog_id)
        except Exception as e:
            self.log("processReadMessages hook: %s" % e)

    def _before_dialogs_update_read(self, param):
        try:
            account = _account_of(param.thisObject)
            arr = param.args[0]
            if arr is None:
                return
            kept = LongSparseIntArray()
            changed = False
            for i in range(arr.size()):
                did = int(arr.keyAt(i))
                value = int(arr.valueAt(i))
                with self.lock:
                    clearing = (account, did) in self.clearing
                if value <= 0 and _is_forum(account, did):
                    _tlog("processDialogsUpdateRead %d count=%d clearing=%s blocked=%s" % (did, value, clearing, value <= 0 and not clearing))
                if value <= 0 and not clearing and _is_forum(account, did):
                    changed = True   # would wipe every topic; let the prune pass decide
                    self._schedule(account, did)
                else:
                    kept.put(did, value)
            if changed:
                param.args[0] = kept
        except Exception as e:
            self.log("processDialogsUpdateRead hook: %s" % e)

    def _before_reload(self, param):
        # Runs before the reload is queued, so this snapshot runs before it too.
        account = _account_of(param.thisObject)

        def snap():
            try:
                nc = NotificationsController.getInstance(account)
                keep = []
                for m in get_private_field(nc, "pushMessages").toArray():
                    if m is None or m.messageOwner.from_scheduled or m.isStoryReactionPush or m.isStoryPush:
                        continue
                    if _is_forum(account, int(m.getDialogId())):
                        keep.append(m)
                with self.lock:
                    self.snapshots[account] = keep
            except Exception as e:
                self.log("reload snapshot: %s" % e)

        self.queue.postRunnable(R(snap))

    def _restore_after_reload(self, account):
        with self.lock:
            saved = self.snapshots.pop(account, None)
        if not saved:
            return
        nc = NotificationsController.getInstance(account)
        push = get_private_field(nc, "pushMessages")
        by_id = get_private_field(nc, "pushMessagesDict")
        dialogs = get_private_field(nc, "pushDialogs")
        opened = int(get_private_field(nc, "openedDialogId"))
        opened_topic = int(get_private_field(nc, "openedTopicId"))
        screen_on = bool(jclass("org.telegram.messenger.ApplicationLoader").isScreenOn)
        present = set((int(m.getDialogId()), int(m.getId())) for m in push.toArray() if m is not None)
        restored = 0
        for m in saved:
            did, mid, tid = int(m.getDialogId()), int(m.getId()), int(m.getTopicId())
            if (did, mid) in present:
                continue
            if mid <= self._topic_read_max(account, did, tid):
                continue   # that topic really was read
            try:
                if MessagesController.getInstance(account).isDialogMuted(did, tid):
                    continue   # muted since, so the reload was right to drop it
            except Exception:
                pass
            if did == opened and screen_on and (tid == opened_topic or opened_topic == 0):
                continue   # you are looking at that topic right now
            pos = 0
            while pos < push.size() and push.get(pos).messageOwner.date > m.messageOwner.date:
                pos += 1
            push.add(pos, m)
            arr = by_id.get(did)
            if arr is None:
                arr = jclass("android.util.SparseArray")()
                by_id.put(did, arr)
            arr.put(mid, m)
            if dialogs.get(did) is None:
                dialogs.put(did, jclass("java.lang.Integer")(1))
                try:
                    f = find_class("org.telegram.messenger.NotificationsController").getDeclaredField("total_unread_count")
                    f.setAccessible(True)
                    f.setInt(nc, f.getInt(nc) + 1)
                except Exception:
                    pass
            present.add((did, mid))
            restored += 1
        if restored:
            self.show_method.invoke(nc, jarray(JObject)([JBoolean(False)]))
            run_on_ui_thread(lambda: NotificationCenter.getGlobalInstance().postNotificationName(NotificationCenter.pushMessagesUpdated))

    def _after_reload(self, param):
        account = _account_of(param.thisObject)

        def restore():
            try:
                self._restore_after_reload(account)
            except Exception as e:
                self.log("reload restore: %s" % e)

        # Queued after the reload itself, so it sees the rebuilt list.
        self.queue.postRunnable(R(restore))

        # The reload rebuilt the pending list from the database; prune every forum
        # group in it (runs after the reload on the same queue).
        try:
            account = _account_of(param.thisObject)
            seen = set()
            dialogs = param.args[0]
            if dialogs is not None:
                for i in range(dialogs.size()):
                    seen.add(int(dialogs.keyAt(i)))
            push = param.args[2]
            if push is not None:
                for m in push.toArray():
                    seen.add(int(m.getDialogId()))
            for did in seen:
                if _is_forum(account, did):
                    self._schedule(account, did)
        except Exception as e:
            self.log("reload hook: %s" % e)

    def _before_new_messages(self, param):
        # Stock drops every new message of a group while any of its chats is open
        # on screen. In a forum that means replies in OTHER topics never notify
        # while you sit in one topic. Those messages are handed to the same
        # method again, with the open group hidden from that one pass only.
        if getattr(self.reentry, "on", False):
            return
        try:
            msgs = param.args[0]
            if msgs is None or msgs.size() == 0:
                return
            nc = param.thisObject
            account = _account_of(nc)
            opened = int(get_private_field(nc, "openedDialogId"))
            if opened == 0 or not _is_forum(account, opened):
                return
            opened_topic = int(get_private_field(nc, "openedTopicId"))
            if opened_topic == 0:
                return   # the whole group is open (flat view): stock is right
            ArrayList = jclass("java.util.ArrayList")
            others = ArrayList()
            keep = ArrayList()
            for m in msgs.toArray():
                try:
                    if m is not None and int(m.getDialogId()) == opened and int(m.getTopicId()) != opened_topic:
                        others.add(m)
                        continue
                except Exception:
                    pass
                keep.add(m)
            if others.size() == 0:
                return
            with self.lock:
                gen = self.open_gen
            state = {"swapped": False}
            field = find_class("org.telegram.messenger.NotificationsController").getDeclaredField("openedDialogId")
            field.setAccessible(True)

            def hide():
                with self.lock:
                    same = self.open_gen == gen
                if same and int(field.getLong(nc)) == opened:
                    field.setLong(nc, 0)
                    state["swapped"] = True

            def unhide():
                if not state["swapped"]:
                    return
                with self.lock:
                    same = self.open_gen == gen
                if same and int(field.getLong(nc)) == 0:
                    field.setLong(nc, opened)

            self.queue.postRunnable(R(hide))
            _tlog("other topics notify while in %d topic %d: %s" % (opened, opened_topic, [int(m.getTopicId()) for m in others.toArray()]))
            self.reentry.on = True
            try:
                nc.processNewMessages(others, param.args[1], param.args[2], None)
            finally:
                self.reentry.on = False
            self.queue.postRunnable(R(unhide))
            param.args[0] = keep
        except Exception as e:
            self.reentry.on = False
            self.log("new messages hook: %s" % e)

    def _before_read_all_topics(self, param):
        try:
            st = param.thisObject
            account = int(get_private_field(st, "currentAccount"))
            dialog_id = int(param.args[0])
            if not _tabs_forum(account, dialog_id):
                return
            with self.lock:
                t = self.all_tab_read.get((account, dialog_id), 0)
            if time.time() - t <= ALL_TAB_WINDOW_S:
                _tlog("readAllTopics %d old=%d new=%d ALLOWED (All tab read)" % (dialog_id, int(param.args[1]), int(param.args[2])))
                with self.lock:
                    if self.floors.get((account, dialog_id), 0) < int(param.args[2]):
                        self.floors[(account, dialog_id)] = int(param.args[2])
                self._save_reads()
                return
            _tlog("readAllTopics %d old=%d new=%d SKIPPED, topics keep their own read marks" % (dialog_id, int(param.args[1]), int(param.args[2])))
            param.setResult(None)
        except Exception as e:
            _tlog("read all topics hook: %s" % e)

    def _before_process_topics(self, param):
        try:
            chat_id = int(param.args[0])
            topics = param.args[1]
            if topics is None or topics.size() == 0:
                return
            account = _account_of(param.thisObject)
            dialog_id = -chat_id
            from_cache = bool(param.args[3])
            if not _tabs_forum(account, dialog_id):
                _tlog("topics list for %d skipped, not a forum here yet" % dialog_id)
                return
            seen = []
            for t in topics.toArray():
                try:
                    tid = int(t.id)
                    srv = int(t.read_inbox_max_id)
                    top = int(t.top_message)
                except Exception:
                    continue
                m = self._mark(account, dialog_id, tid)
                if m is None:
                    # Learn a topic's mark only from the server's own list; the cached
                    # copy can carry an old or empty read mark.
                    if from_cache or srv <= 0:
                        continue
                    with self.lock:
                        self.read_max[(account, dialog_id, tid)] = srv
                    seen.append(tid)
                    continue
                if srv > m:
                    _tlog("topic %d/%d %s says read to %d, kept at %d (top %d)" % (dialog_id, tid, "cache" if from_cache else "server", srv, m, top))
                    t.read_inbox_max_id = m
                    if top > m and int(t.unread_count) <= 0:
                        t.unread_count = 1
                if top > m:
                    self._fix_topic_count(account, chat_id, tid, m, top)
            if seen:
                _tlog("first sight of topics %s in %d" % (seen, dialog_id))
                self._save_reads()
        except Exception as e:
            _tlog("process topics hook: %s" % e)

    def _reconcile(self, account, dialog_id):
        """Put this plugin's read marks back on every loaded topic of a group."""
        try:
            if not _tabs_forum(account, dialog_id):
                return
            tc = MessagesController.getInstance(account).getTopicsController()
            topics = tc.getTopics(-dialog_id)
            if topics is None:
                return
            for t in topics.toArray():
                try:
                    tid = int(t.id)
                    srv = int(t.read_inbox_max_id)
                    top = int(t.top_message)
                except Exception:
                    continue
                m = self._mark(account, dialog_id, tid)
                if m is None:
                    continue
                if srv > m or (top > m and int(t.unread_count) <= 0):
                    _tlog("reconcile %d/%d app says read to %d unread %d, kept at %d (top %d)" % (dialog_id, tid, srv, int(t.unread_count), m, top))
                    t.read_inbox_max_id = m
                    self._fix_topic_count(account, -dialog_id, tid, m, top)
        except Exception as e:
            _tlog("reconcile: %s" % e)

    def _fix_topic_count(self, account, chat_id, tid, mark, top):
        ms = jclass("org.telegram.messenger.MessagesStorage").getInstance(account)
        dialog_id = -chat_id

        def count():
            try:
                cur = ms.getDatabase().queryFinalized("SELECT count(mid) FROM messages_topics WHERE uid = %d AND topic_id = %d AND mid > %d AND out = 0" % (dialog_id, tid, mark))
                n = 0
                if cur.next():
                    n = int(cur.intValue(0))
                cur.dispose()
                n = max(n, 1 if top > mark else 0)

                def ui():
                    try:
                        tc = MessagesController.getInstance(account).getTopicsController()
                        tc.updateMaxReadId(chat_id, tid, mark, n, -1)
                        NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.topicsDidLoaded, jclass("java.lang.Long")(chat_id), JBoolean(True))
                    except Exception as e:
                        _tlog("topic count ui: %s" % e)

                    def write():
                        try:
                            ms.getDatabase().executeFast("UPDATE topics SET max_read_id = %d, unread_count = %d WHERE did = %d AND topic_id = %d" % (mark, n, dialog_id, tid)).stepThis().dispose()
                        except Exception as e:
                            _tlog("topic count write: %s" % e)
                    ms.getStorageQueue().postRunnable(R(write))

                run_on_ui_thread(ui)
            except Exception as e:
                _tlog("topic count: %s" % e)

        ms.getStorageQueue().postRunnable(R(count))

    def on_update_hook(self, update_name, account, update):
        try:
            if "updateReadChannelInbox" in update_name and "Discussion" not in update_name:
                _tlog("server group read ch=%d max=%d still=%d" % (int(update.channel_id), int(update.max_id), int(update.still_unread_count)))
                return HookResult()
            if "updateReadChannelDiscussionInbox" in update_name:
                did = -int(update.channel_id)
                if _is_forum(account, did):
                    _tlog("server topic read %d topic=%d max=%d" % (did, int(update.top_msg_id), int(update.read_max_id)))
                    self._mark_topic_read(account, did, int(update.top_msg_id), int(update.read_max_id))
                    self._schedule(account, did)
        except Exception as e:
            self.log("update hook: %s" % e)
        return HookResult()

    def on_send_message_hook(self, account, params):
        try:
            did = int(params.peer)
            if _is_forum(account, did):
                top = params.replyToTopMsg
                topic_id = int(top.getId()) if top is not None else 1   # 1 = General
                _tlog("send %d topic=%d" % (did, topic_id))
                self._schedule(account, did, sent_topic=topic_id)
        except Exception as e:
            self.log("send hook: %s" % e)
        return HookResult()

    # ---------- prune pass (runs on the notifications queue) ----------

    def _schedule(self, account, dialog_id, read_message=None, sent_topic=None):
        key = (account, int(dialog_id))

        def run():
            try:
                self._prune(account, int(dialog_id), read_message, sent_topic)
            except Exception as e:
                self.log("prune: %s" % e)

        if read_message is None and sent_topic is None:
            with self.lock:
                if key in self.pending:
                    return
                self.pending.add(key)
        self.queue.postRunnable(R(run), PRUNE_DELAY_MS)

    def _prune(self, account, dialog_id, read_message, sent_topic):
        with self.lock:
            self.pending.discard((account, dialog_id))
        nc = NotificationsController.getInstance(account)
        push = get_private_field(nc, "pushMessages")
        delayed = get_private_field(nc, "delayedPushMessages")
        by_id = get_private_field(nc, "pushMessagesDict")
        if push is None:
            return

        mine = []
        for m in push.toArray():
            if m is None or int(m.getDialogId()) != dialog_id:
                continue
            if m.messageOwner.from_scheduled or m.isStoryReactionPush:
                continue
            mine.append((m, int(m.getTopicId()), int(m.getId())))

        # A read without a topic marks the topic of the read message.
        if read_message is not None:
            for m, tid, mid in mine:
                if mid == read_message:
                    self._mark_topic_read(account, dialog_id, tid, read_message)
        # Sending into a topic reads everything pending in that topic.
        if sent_topic is not None:
            ids = [mid for m, tid, mid in mine if tid == sent_topic]
            if ids:
                self._mark_topic_read(account, dialog_id, sent_topic, max(ids))

        removed = [m for m, tid, mid in mine if mid <= self._topic_read_max(account, dialog_id, tid)]
        _tlog("prune %d keep=%s remove=%s" % (dialog_id, [(tid, mid) for m, tid, mid in mine if m not in removed], [(int(m.getTopicId()), int(m.getId())) for m in removed]))
        if not removed:
            return
        for m in removed:
            push.remove(m)
            if delayed is not None:
                delayed.remove(m)
            if by_id is not None:
                arr = by_id.get(dialog_id)
                if arr is not None:
                    arr.remove(m.getId())
                    if arr.size() == 0:
                        by_id.remove(dialog_id)

        if len(removed) == len(mine):
            # Nothing left in this group: let stock do its full cleanup
            # (counters, badge, summary). It is a "clear all" so our hooks pass it.
            nc.removeNotificationsForDialog(dialog_id)
        else:
            # Silent refresh: drops the read topics' notifications, keeps the rest.
            self.show_method.invoke(nc, jarray(JObject)([JBoolean(False)]))

        def ui():
            try:
                popup = nc.popupMessages
                for m in removed:
                    popup.remove(m)
                NotificationCenter.getGlobalInstance().postNotificationName(NotificationCenter.pushMessagesUpdated)
            except Exception as e:
                self.log("ui refresh: %s" % e)

        run_on_ui_thread(ui)
